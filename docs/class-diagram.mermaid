classDiagram
    class NetworkConnection {
        +int id
        +int host_id
        +str protocol
        +str local_addr
        +int local_port
        +str remote_addr
        +int remote_port
        +str state
        +int pid
        +str process_name
        +str collected_at
        +batch_create(host_id, items) int$
        +list_by_host(host_id) list$
        +delete_by_host(host_id)$
    }

    class FileHash {
        +int id
        +int host_id
        +str file_path
        +str file_name
        +str sha256
        +int is_signed
        +str signer
        +int file_size
        +str product_name
        +str product_version
        +str collected_at
        +batch_create(host_id, items) int$
        +list_by_host(host_id) list$
        +delete_by_host(host_id)$
    }

    class WmiSubscription {
        +int id
        +int host_id
        +str name
        +str event_filter
        +str event_consumer
        +str binding_type
        +str risk_level
        +str collected_at
        +batch_create(host_id, items) int$
        +list_by_host(host_id) list$
        +delete_by_host(host_id)$
    }

    class RegistryKey {
        +int id
        +int host_id
        +str key_path
        +str value_name
        +str value_type
        +str value_data
        +str last_write_time
        +str collected_at
        +batch_create(host_id, items) int$
        +list_by_host(host_id) list$
        +delete_by_host(host_id)$
    }

    class AnalysisService {
        +get_network_connections(host_id) list$
        +get_file_hashes(host_id) list$
        +get_wmi_subscriptions(host_id) list$
        +get_registry_keys(host_id) list$
    }

    class FastAPIRouter {
        +GET /hosts/{host_id}/network-connections
        +GET /hosts/{host_id}/file-hashes
        +GET /hosts/{host_id}/wmi-subscriptions
        +GET /hosts/{host_id}/registry-keys
    }

    FastAPIRouter --> AnalysisService : 调用
    AnalysisService --> NetworkConnection : list_by_host()
    AnalysisService --> FileHash : list_by_host()
    AnalysisService --> WmiSubscription : list_by_host()
    AnalysisService --> RegistryKey : list_by_host()

    NetworkConnection --> "hosts" : host_id FK
    FileHash --> "hosts" : host_id FK
    WmiSubscription --> "hosts" : host_id FK
    RegistryKey --> "hosts" : host_id FK
