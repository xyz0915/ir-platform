classDiagram
    direction LR

    class Ioc {
        <<existing, 不改签名>>
        +int id
        +str ioc_type
        +str ioc_value
        +bool enabled
        +create() dict
        +get_by_id(id) dict
        +list(ioc_type) list
        +update(id, ...) dict
        +delete(id) bool
        +batch_create(items) int
    }

    class ThreatIntel {
        +int id
        +int ioc_id
        +str ioc_type
        +str ioc_value
        +str provider
        +int risk_score
        +list judgments
        +list tags
        +int confidence
        +list attck
        +str company
        +str threat_level
        +str queried_at
        +str raw_summary
        +str created_at
        +create(ioc, intel) dict
        +get_by_ioc(ioc_id) list
        +list_by_ioc(ioc_id) list
        +get_latest_threat_level() dict
    }

    class ThreatIntelProviderConfig {
        +str name
        +str type
        +str api_key_ref
        +str api_url
        +bool enabled
        +float rate_limit_qps
        +load_all() list
        +get(name) dict
        +save(cfg) dict
    }

    class EnrichSettings {
        +bool enable_enrichment
        +bool auto_enrich
        +int daily_quota
        +int recheck_days
        +int scheduler_interval
        +load() EnrichSettings
        +save() dict
    }

    class NormalizedIntel {
        +str provider
        +str ioc_type
        +str ioc_value
        +int risk_score
        +list judgments
        +list tags
        +int confidence
        +list attck
        +str company
        +str raw_summary
    }

    class BaseThreatIntelProvider {
        <<abstract>>
        +str name
        +set supported_types
        +query(ioc_type, ioc_value)* NormalizedIntel
        +normalize(raw) NormalizedIntel
    }

    class ThreatBookProvider {
        +query(ioc_type, ioc_value) NormalizedIntel
        +normalize(raw) NormalizedIntel
    }

    class EnrichmentService {
        +enrich_ioc(ioc) ThreatIntel
        +enrich_batch(iocs) dict
        +scan_pending_iocs() dict
        -_select_provider(ioc_type) BaseThreatIntelProvider
        -_dedup(ioc, provider) bool
        -_enforce_quota() bool
    }

    class RuleEngine {
        <<existing, 最小改动>>
        +evaluate(items, rules, ctx) list
        +_match_list(item, cond, ctx) bool
    }

    Ioc "1" --> "0..*" ThreatIntel : ioc_id
    ThreatIntelProviderConfig ..> BaseThreatIntelProvider : 配置驱动实例化
    BaseThreatIntelProvider <|-- ThreatBookProvider
    ThreatBookProvider ..> NormalizedIntel : 返回
    EnrichmentService ..> BaseThreatIntelProvider : 使用
    EnrichmentService ..> ThreatIntel : 落库
    EnrichmentService ..> EnrichSettings : 读开关/配额
    RuleEngine ..> ThreatIntel : 读最新威胁等级
    EnrichSettings ..> ThreatIntelProviderConfig : 并列配置(分离文件)
