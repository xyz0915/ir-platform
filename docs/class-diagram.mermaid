classDiagram
    %% ===== SSE Event Model =====
    class StreamingEvent {
        +str event_name
        +str session_id
        +str intent
        +float confidence
    }
    class TextChunkEvent {
        +str type: "text"
        +str content
    }
    class CardEvent {
        +str type: "card"
        +str card_type
        +dict data
        +list~str~ action_hints
    }
    class ActionConfirmEvent {
        +str type: "action_confirm"
        +str action
        +str target
        +str reason
        +str confirm_id
        +bool require_confirm
    }
    class ActionResultEvent {
        +str type: "action_result"
        +str action
        +str status
        +dict result
        +int exec_time_ms
        +str error
    }
    class PlaybookProgressEvent {
        +str type: "playbook_progress"
        +int step
        +int total
        +str current_step_name
        +str status
    }
    class QueryEndEvent {
        +str type: "query_end"
        +str session_id
        +dict usage
        +str confidence
        +list~str~ source_ids
        +dict attack_path
    }

    %% ===== Action Model =====
    class ActionIntent {
        +str action
        +dict target
        +str reason
        +bool confirm_required
        +str confirm_id
    }
    class ActionResult {
        +bool success
        +str action
        +str status
        +dict result
        +str error
        +str rule_id
        +int exec_time_ms
        +list~str~ affected_hosts
    }
    class ActionMapEntry {
        +str user_intent
        +str action_name
        +str backend_api
        +bool high_risk
        +str confirm_text
        +callable executor
    }

    %% ===== Playbook Model =====
    class PlaybookDef {
        +str id
        +str name
        +str description
        +list~PlaybookStep~ steps
    }
    class PlaybookStep {
        +str name
        +str action
        +dict params
        +str prompt
        +list~str~ depends_on
    }
    class PlaybookStatus {
        +str playbook_id
        +str playbook_name
        +str status
        +int current_step
        +int total_steps
        +float progress_pct
        +list~StepResult~ step_results
    }
    class StepResult {
        +str step_name
        +str status
        +str output
        +str error
        +float duration_ms
    }

    %% ===== Context Model =====
    class ContextState {
        +int host_id
        +str host_name
        +str host_ip
        +int alert_count
        +int risk_score
        +str last_active
        +bool pinned
    }
    class HostOption {
        +int id
        +str hostname
        +str ip_address
        +str status
        +int alert_count
    }

    %% ===== Attack Path Model =====
    class AttackPathNode {
        +str id
        +str label
        +str type
        +str ip
        +str severity
        +int risk_score
        +str detail_url
    }
    class AttackPathEdge {
        +str source
        +str target
        +str technique_id
        +str technique_name
        +str time
        +str confidence
        +list~str~ evidence_ids
    }
    class AttackPathData {
        +list~AttackPathNode~ nodes
        +list~AttackPathEdge~ edges
        +str summary
        +int total_alerts
        +int total_hosts
    }

    %% ===== Session Summary Model =====
    class SessionSummary {
        +str session_id
        +str purpose
        +dict coverage
        +list~str~ key_findings
        +list~dict~ actions_taken
        +str status
        +str generated_at
    }

    %% ===== File Upload Model =====
    class FileUpload {
        +str name
        +str type
        +str content_base64
        +int size_bytes
    }
    class FileParseResult {
        +bool success
        +str file_type
        +str parsed_text
        +str intent
        +str error
    }

    %% ===== Relationships =====
    StreamingEvent <|-- TextChunkEvent
    StreamingEvent <|-- CardEvent
    StreamingEvent <|-- ActionConfirmEvent
    StreamingEvent <|-- ActionResultEvent
    StreamingEvent <|-- PlaybookProgressEvent
    StreamingEvent <|-- QueryEndEvent
    ActionIntent --> ActionResult : executes to
    ActionMapEntry --> ActionIntent : maps to
    PlaybookDef *-- PlaybookStep : contains
    PlaybookStatus *-- StepResult : contains
    PlaybookDef --> PlaybookStatus : produces
    AttackPathData *-- AttackPathNode : contains
    AttackPathData *-- AttackPathEdge : contains
