classDiagram
    class PipelineNode {
        +string id
        +string type
        +string label
        +Position position
        +string badgeText
        +string statText
        +object config
        +array dependencies
        +array tools
        +string prompt
        +array variables
        +boolean hasInConnector
        +boolean hasOutConnector
        +int track
        +int stepIndex
        +boolean selected
        +select()
        +move(x, y)
    }

    class Connection {
        +string sourceId
        +string targetId
        +string pathD
        +boolean isCrossTrack
        +string dashStyle
    }

    class PipelineEditorStore {
        +array~PipelineNode~ pipelineNodes
        +array~Connection~ connections
        +string selectedNodeId
        +boolean configDirty
        +number zoomLevel
        +boolean connectMode
        +string connectSource
        +array validationMessages
        +boolean isValid
        +addNode(type, position)
        +removeNode(nodeId)
        +moveNode(nodeId, position)
        +selectNode(nodeId)
        +startConnect(sourceId)
        +completeConnect(targetId)
        +cancelConnect()
        +updateNodeConfig(nodeId, patch)
        +validatePipeline()
        +runPipeline(eventId)
        +clearCanvas()
    }

    class AgentManagementStore {
        +array agents
        +array pipeline
        +array presets
        +object currentRun
        +string selectedNode
        +fetchAgents()
        +addToPipeline(agent)
        +removeFromPipeline(name)
        +updateNodeConfig(name, config)
        +startPipeline(eventId)
        +savePreset(name, desc)
        +loadPresetToPipeline(preset)
    }

    PipelineEditorStore --> PipelineNode : manages
    PipelineEditorStore --> Connection : manages
    PipelineEditorStore --> AgentManagementStore : bridges via selectedNodeId
    AgentManagementStore --> PipelineEditorStore : reads pipelineNodes for run/validate
