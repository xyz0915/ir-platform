    class ProcessesCollector {
        +str name
        +list~str~ platform
        +collect() list
        +_collect_fallback() list
        +_build_connection_map(psutil) dict
        +_enrich(proc: dict) void
    }

    class NetworkCollector {
        +str name
        +list~str~ platform
        +collect() dict
        +_collect_windows_connections() dict
        +_build_network_connections(connections: list) list
        +_get_connections() list
    }

    class RegistryCollector {
        +str name
        +list~str~ platform
        +collect() dict
        +_build_registry_keys(run_keys, services, shell_extensions) list
        +_get_run_keys() list
        +_get_shell_extensions() list
    }

    class StartupItemsCollector {
        +str name
        +list~str~ platform
        +collect() list
        +_collect_windows() list
        +_get_registry_run_keys() list
    }

    class ServicesCollector {
        +str name
        +list~str~ platform
        +collect() list
        +_collect_windows() list
        +_collect_linux() list
    }

