classDiagram
    class ServiceRiskAnalyzer {
        <<static>>
        +analyze(raw_data: dict, host_id: int) dict
        -_extract_services(raw_data: dict) list~dict~
        -_detect_tamper(services: list) list~dict~
        -_detect_shadow(services: list) list~dict~
        -_detect_priv_esc(services: list) list~dict~
        -_calc_edit_distance(a: str, b: str) float
        -_normalize_path(path: str) str
        -_calculate_aggregate_score(services: list) tuple
    }

    class ServiceRiskItem {
        +service_name: str
        +display_name: str
        +status: str
        +start_type: str
        +binary_path: str
        +user: str
        +risk_score: int
        +detections: list~DetectionResult~
    }

    class DetectionResult {
        +rule_id: str
        +rule_name: str
        +triggered: bool
        +severity: str
        +weight: int
        +detail: str
    }

    class ServiceRiskReport {
        +services: list~ServiceRiskItem~
        +aggregate_score: int
        +summary: dict
        +stats: dict
    }

    class RiskAssessor {
        <<static>>
        +SEVERITY_WEIGHTS: dict
        +RISK_LEVELS: list
        +assess(findings: dict) dict
        +calculate_score(findings: dict) int
        -_calculate_category_score(items: list) int
        -_score_to_level(score: int) str
        -_generate_summary(risk_level: str, score: int, total: int, details: dict) str
    }

    class AnalysisService {
        <<static>>
        +analyze(host_id: int) dict
        +get_analysis(host_id: int) dict
        +get_service_risk(host_id: int) dict
        -_inject_exe_signatures(raw_data: dict) None
        -_build_tiered_data(raw_data: dict) dict
        -_cross_validate(abnormal_processes: list, semantic_hits: list, suspicious_connections: list, webshell_hits: list, memory_shell_hits: list, persistence_items: list) list
        -_aggregate_incidents(incidents: list) list
    }

    class ServiceConstants {
        <<constant>>
        SECURITY_SERVICES: list~str~
        SCORING_WEIGHTS: dict~str,int~
        TRUSTED_PATHS: list~str~
        KNOWN_LEGIT_SERVICES: set~str~
        START_TYPE_RISK: dict~str,int~
        SERVICE_NAME_SIMILARITY_THRESHOLD: float
        SUSPICIOUS_PATH_KEYWORDS: list~str~
    }

    ServiceRiskAnalyzer ..> ServiceRiskItem : produces
    ServiceRiskItem *-- DetectionResult : contains (1..*)
    ServiceRiskAnalyzer ..> ServiceRiskReport : produces
    ServiceRiskReport o-- ServiceRiskItem : aggregates
    ServiceRiskAnalyzer ..> ServiceConstants : reads
    AnalysisService --> ServiceRiskAnalyzer : calls analyze()
    AnalysisService ..> ServiceRiskReport : returns via API
    RiskAssessor --> ServiceRiskReport : consumes for scoring
