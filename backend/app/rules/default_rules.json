[
  {
    "name": "powershell_encoded_command",
    "description": "检测 PowerShell 编码命令执行（常见于恶意脚本）",
    "category": "process",
    "rule_type": "regex",
    "condition": {"field": "command_line", "pattern": "powershell.*(-enc|-encodedcommand)\\s+", "flags": "ignorecase", "_meta": {"mitre_attack": "T1059/001"}},
    "severity": "high",
    "enabled": true
  },
  {
    "name": "powershell_bypass_execution",
    "description": "PowerShell 绕过执行策略",
    "category": "process",
    "rule_type": "regex",
    "condition": {"field": "command_line", "pattern": "powershell.*-ExecutionPolicy.*(Bypass|Unrestricted)", "flags": "ignorecase", "_meta": {"mitre_attack": "T1059/001"}},
    "severity": "high",
    "enabled": true
  },
  {
    "name": "certutil_download",
    "description": "certutil 用于下载文件（常见于恶意下载行为）",
    "category": "process",
    "rule_type": "regex",
    "condition": {"field": "command_line", "pattern": "certutil.*-urlcache.*-split", "flags": "ignorecase", "_meta": {"mitre_attack": "T1105"}},
    "severity": "high",
    "enabled": true
  },
  {
    "name": "bitsadmin_download",
    "description": "bitsadmin 用于下载文件",
    "category": "process",
    "rule_type": "regex",
    "condition": {"field": "command_line", "pattern": "bitsadmin.*/transfer", "flags": "ignorecase", "_meta": {"mitre_attack": "T1197"}},
    "severity": "high",
    "enabled": true
  },
  {
    "name": "suspicious_mshta",
    "description": "mshta 执行远程脚本",
    "category": "process",
    "rule_type": "regex",
    "condition": {"field": "command_line", "pattern": "mshta.*(http|https|javascript|vbscript)", "flags": "ignorecase", "_meta": {"mitre_attack": "T1218/005"}},
    "severity": "critical",
    "enabled": true
  },
  {
    "name": "regsvr32_squiblydoo",
    "description": "regsvr32 执行远程脚本（Squiblydoo 技术）",
    "category": "process",
    "rule_type": "regex",
    "condition": {"field": "command_line", "pattern": "regsvr32.*/s.*/u.*(http|https|scrobi)", "flags": "ignorecase", "_meta": {"mitre_attack": "T1218/011"}},
    "severity": "critical",
    "enabled": true
  },
  {
    "name": "wmic_process_create",
    "description": "WMIC 远程进程创建",
    "category": "process",
    "rule_type": "regex",
    "condition": {"field": "command_line", "pattern": "wmic.*process.*call.*create", "flags": "ignorecase", "_meta": {"mitre_attack": "T1047"}},
    "severity": "high",
    "enabled": true
  },
  {
    "name": "rundll32_suspicious",
    "description": "rundll32 加载可疑模块",
    "category": "process",
    "rule_type": "regex",
    "condition": {"field": "command_line", "pattern": "rundll32.*(shell32|javascript|http)", "flags": "ignorecase", "_meta": {"mitre_attack": "T1218/011"}},
    "severity": "high",
    "enabled": true
  },
  {
    "name": "cmd_powershell_chain",
    "description": "cmd 启动 powershell（常见于恶意脚本链）",
    "category": "process",
    "rule_type": "regex",
    "condition": {"field": "command_line", "pattern": "cmd.*/c.*powershell", "flags": "ignorecase", "_meta": {"mitre_attack": "T1059/001"}},
    "severity": "medium",
    "enabled": true
