    "condition": {"field": "command_line", "pattern": "(nslookup|dig|Resolve-DnsName).*(-q=|-type=|txt.*[A-Za-z0-9+/=]{50,})", "flags": "ignorecase", "_meta": {"mitre_attack": "T1048/003"}},
    "severity": "critical",
    "enabled": true
  },
  {
    "name": "icmp_tunnel_exfil",
    "description": "ICMP 隧道数据外传检测",
