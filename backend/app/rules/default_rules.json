    "condition": {
      "logic": "OR",
      "sub_rules": [
        {"type": "behavior", "pattern": "uac_bypass", "description": "UAC 绕过"},
        {"type": "behavior", "pattern": "token_manipulation", "description": "Token 操作"}
      ],
      "_meta": {"mitre_attack": "T1548"}
    },
    "severity": "critical",
    "enabled": true
  },
  {
    "name": "kerberoasting_detection",
