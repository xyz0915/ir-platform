    "condition": {"field": "command_line", "pattern": "(Get-Clipboard|clipboard|System\\.Windows\\.Clipboard|GTK\\.Clipboard)", "flags": "ignorecase", "_meta": {"mitre_attack": "T1115"}},
    "severity": "medium",
    "enabled": true
  },

  {
    "name": "data_compression_exfil",
    "description": "数据压缩并外传检测（压缩工具+网络上传组合）",
