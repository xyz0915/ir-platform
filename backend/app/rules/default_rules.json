  },
  {
    "name": "wmi_remote_execution",
    "description": "WMI 远程执行横向移动检测",
    "category": "lateral",
    "rule_type": "behavior",
    "condition": {"pattern": "lateral_movement", "description": "横向移动行为检测", "_meta": {"mitre_attack": "T1047"}},
    "severity": "critical",
    "enabled": true
  },
  {
    "name": "rdp_tunnel_detection",
    "description": "RDP 隧道/跳板检测（端口转发/RDP 包装器）",
