[
  {
    "name": "dotnet_inline_compilation",
    "description": "检测 DotNet/csc 内联编译执行（无文件落地的内存加载，常见于无文件攻击）",
    "category": "execution",
    "rule_type": "composite",
    "condition": {
      "logic": "AND",
      "sub_rules": [
        {"type": "regex", "field": "name", "pattern": "(csc|dotnet)\\.exe", "flags": "ignorecase"},
        {"type": "regex", "field": "command_line", "pattern": "(CSharpCodeProvider|CodeDOM|\\.cs\\b|Inline|CompileAssemblyFromSource)", "flags": "ignorecase"}
      ],
      "_meta": {
        "mitre_attack": "T1059/001"
      }
    },
    "severity": "high",
    "enabled": true,
    "label": "DotNet 内联编译执行（无文件）"
  },
  {
    "name": "msbuild_inline_task_execution",
    "description": "检测 MSBuild 内联任务（InlineTasks/UsingTask）执行，典型的无文件 LOLBin 利用",
    "category": "execution",
    "rule_type": "regex",
    "condition": {
      "field": "name",
      "pattern": "msbuild\\.exe",
      "flags": "ignorecase",
      "_meta": {
        "mitre_attack": "T1127/001"
      }
    },
    "severity": "high",
    "enabled": true,
    "label": "MSBuild 内联任务执行（无文件 LOLBin）"
  },
  {
    "name": "msiexec_remote_lolbin",
    "description": "检测 MSIExec 从远程 URL 下载并执行 (.msi)，典型的 LOLBin 远程加载",
    "category": "execution",
    "rule_type": "regex",
    "condition": {
      "field": "name",
      "pattern": "msiexec\\.exe",
      "flags": "ignorecase",
      "_meta": {
        "mitre_attack": "T1218/007"
      }
    },
    "severity": "high",
    "enabled": true,
    "label": "MSIExec 远程下载执行（LOLBin）"
  },
  {
    "name": "suspicious_scheduled_task_xml_exists",
    "description": "检测数据项中存在可疑计划任务 XML 定义（计划任务持久化迹象）",
    "category": "persistence",
