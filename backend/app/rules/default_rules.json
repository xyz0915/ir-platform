  {
    "name": "suspicious_run_key",
    "description": "可疑 Run 键项（非系统标准启动项）",
    "category": "startup",
    "rule_type": "regex",
    "condition": {"field": "command", "pattern": "(powershell|cmd|wscript|cscript|mshta|regsvr32)", "flags": "ignorecase", "_meta": {"mitre_attack": "T1547/001"}},
    "severity": "high",
    "enabled": true
  },
