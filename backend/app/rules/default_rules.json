  {
    "name": "data_staging_directory",
    "description": "数据暂存目录检测（临时目录大量文件写入）",
    "category": "discovery",
    "rule_type": "composite",
    "condition": {
      "logic": "AND",
      "sub_rules": [
        {"type": "regex", "field": "path", "pattern": "(\\\\Temp\\\\|\\\\Users\\\\Public\\\\Documents)", "flags": "ignorecase"},
        {"type": "threshold", "field": "file_count", "operator": ">", "value": 10}
      ],
      "_meta": {"mitre_attack": "T1074/001"}
    },
    "severity": "medium",
    "enabled": true
  },
  {
    "name": "clipboard_capture",
    "description": "剪贴板数据捕获检测",
    "category": "discovery",
