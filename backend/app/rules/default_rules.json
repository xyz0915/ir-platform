  {
    "name": "phishing_doc_macro",
    "description": "钓鱼文档宏执行（Word/Excel 启动脚本宿主进程）",
    "category": "execution",
    "rule_type": "composite",
    "condition": {
      "logic": "AND",
      "sub_rules": [
        {"type": "regex", "field": "parent_name", "pattern": "(winword|excel|powerpnt)\\.exe", "flags": "ignorecase"},
        {"type": "regex", "field": "name", "pattern": "(powershell|cmd|wscript|cscript|mshta)\\.exe", "flags": "ignorecase"}
      ],
      "_meta": {"mitre_attack": "T1566/001"}
    },
    "severity": "critical",
    "enabled": true
  },
  {
    "name": "exploit_script_download",
    "description": "检测漏洞利用脚本下载执行（CVE exploit 特征）",
    "category": "execution",
    "rule_type": "regex",
    "condition": {"field": "command_line", "pattern": "(Invoke-WebRequest|Invoke-RestMethod|wget|curl).*(Invoke-|Get-Exploit|CVE-|exploit)", "flags": "ignorecase", "_meta": {"mitre_attack": "T1203"}},
    "severity": "critical",
    "enabled": true
  },
  {
    "name": "malicious_macro_indicator",
