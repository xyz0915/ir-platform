    "rule_type": "regex",
    "condition": {"field": "command_line", "pattern": "(plink|ssh.*-L|ssh.*-R|rdpwrap|termsrv\\.dll|RDPWrap)", "flags": "ignorecase", "_meta": {"mitre_attack": "T1021/001"}},
