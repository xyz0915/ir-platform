    "condition": {"field": "command_line", "pattern": "(sekurlsa::pth|mimikatz.*pth|Invoke-WMIExec.*-Hash|Invoke-SMBExec.*-Hash)", "flags": "ignorecase", "_meta": {"mitre_attack": "T1550/002"}},
    "severity": "critical",
    "enabled": true
  },
  {
    "name": "dll_hijack_behavior",
    "description": "DLL 侧加载行为检测",
    "category": "persistence",
    "rule_type": "behavior",
    "condition": {"pattern": "dll_sideload", "description": "DLL 侧加载行为检测", "_meta": {"mitre_attack": "T1574/002"}},
    "severity": "high",
    "enabled": true
  },
  {
    "name": "parent_pid_spoofing",
    "description": "父进程PID欺骗检测（ppid参数传递）",
    "category": "defense_evasion",
    "rule_type": "regex",
    "condition": {"field": "command_line", "pattern": "(ppid|ParentProcessId|Start-Process.*-Credential)", "flags": "ignorecase", "_meta": {"mitre_attack": "T1134/004"}},
    "severity": "high",
    "enabled": true
  },
  {
    "name": "reflective_dll_injection",
    "description": "反射式 DLL 注入检测",
    "category": "defense_evasion",
    "rule_type": "regex",
    "condition": {"field": "command_line", "pattern": "(ReflectiveLoader|Invoke-ReflectivePEInjection|LoadLibrary.*Memory)", "flags": "ignorecase", "_meta": {"mitre_attack": "T1055"}},
    "severity": "critical",
    "enabled": true
  },
  {
    "name": "smb_share_enumeration",
    "description": "SMB 共享枚举/访问检测（横向移动前奏）",
    "category": "discovery",
    "rule_type": "regex",
    "condition": {"field": "command_line", "pattern": "(net view|net share|Get-SmbShare|smbclient -L)", "flags": "ignorecase", "_meta": {"mitre_attack": "T1135"}},
    "severity": "medium",
    "enabled": true
  },
  {
    "name": "scheduled_task_lateral",
    "description": "计划任务远程创建（schtasks /s 远程主机）",
    "category": "lateral",
    "rule_type": "regex",
    "condition": {"field": "command_line", "pattern": "schtasks.*(/create|/run).*/s\\s+\\S+", "flags": "ignorecase", "_meta": {"mitre_attack": "T1053/005"}},
    "severity": "high",
    "enabled": true
  },
  {
    "name": "process_chain_attack",
    "description": "检测 ≥3 级可疑进程链路（攻击路径）",
    "category": "behavior",
    "rule_type": "behavior",
    "condition": {
      "pattern": "process_chain",
      "min_chain_length": 3,
      "suspicious_parent_patterns": ["winword.exe", "excel.exe", "powerpnt.exe", "outlook.exe", "chrome.exe", "firefox.exe", "msedge.exe"],
      "suspicious_child_patterns": ["cmd.exe", "powershell.exe", "wscript.exe", "cscript.exe", "curl.exe", "wget.exe"]
    },
    "severity": "critical",
    "enabled": true
  },
  {
    "name": "time_cluster_burst",
    "description": "同一时间窗口（5分钟）内 ≥5 个进程启动触发告警",
    "category": "behavior",
    "rule_type": "behavior",
    "condition": {
      "pattern": "time_cluster",
      "window_minutes": 5,
      "min_count": 5
    },
    "severity": "high",
    "enabled": true
  },
  {
    "name": "short_lived_shell",
    "description": "powershell/cmd 进程存活时间 < 30s 触发告警",
    "category": "behavior",
    "rule_type": "behavior",
    "condition": {
      "pattern": "short_lived",
      "target_processes": ["powershell.exe", "cmd.exe", "wscript.exe", "cscript.exe"],
      "max_alive_seconds": 30
    },
    "severity": "high",
    "enabled": true
  }
