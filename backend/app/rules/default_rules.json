    "rule_type": "regex",
    "condition": {"field": "command_line", "pattern": "(ping|icmp).*(-l\\s+[1-9]\\d{2,}|icmpsh|ptunnel|icmpsend)", "flags": "ignorecase", "_meta": {"mitre_attack": "T1048/003"}},
    "severity": "critical",
    "enabled": true
  },

  {
    "name": "known_c2_framework",
