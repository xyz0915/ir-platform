      }
    },
    "severity": "high",
    "enabled": true,
    "label": "存在可疑计划任务定义"
  },
  {
    "name": "suspicious_service_reg_exists",
    "description": "检测数据项中存在可疑服务镜像路径注册项（服务持久化迹象）",
    "category": "persistence",
    "rule_type": "exists",
    "condition": {
      "field": "service_image_path",
