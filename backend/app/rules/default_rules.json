      }
    },
    "severity": "high",
    "enabled": true,
    "label": "存在可疑服务注册项"
  },
  {
    "name": "powershell_encoded_command",
    "description": "检测 PowerShell 编码命令执行（常见于恶意脚本）",
    "category": "process",
    "rule_type": "composite",
    "condition": {
      "logic": "AND",
      "sub_rules": [
        {"type": "regex", "field": "name", "pattern": "powershell\\.exe", "flags": "ignorecase"},
        {"type": "regex", "field": "command_line", "pattern": "(-enc|-encodedcommand)\\s+", "flags": "ignorecase"}
      ],
      "_meta": {
        "mitre_attack": "T1059/001"
      }
    },
    "severity": "high",
    "enabled": true,
    "label": "PowerShell 编码命令执行"
  },
  {
    "name": "powershell_bypass_execution",
    "description": "PowerShell 绕过执行策略",
    "category": "process",
    "rule_type": "regex",
    "condition": {
      "field": "command_line",
      "pattern": "powershell.*-ExecutionPolicy.*(Bypass|Unrestricted)",
      "flags": "ignorecase",
      "_meta": {
        "mitre_attack": "T1059/001"
      }
    },
    "severity": "high",
    "enabled": true,
    "label": "PowerShell 绕过执行策略"
  },
  {
