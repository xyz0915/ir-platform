    "category": "attack_chain",
    "rule_type": "attack_chain",
    "severity": "critical",
    "enabled": true,
    "source": "default",
    "mitre_attack": "T1566.001/T1204.002/T1059.001/T1041",
    "condition": {
      "_meta": {
        "mitre_attack": "T1566.001/T1204.002/T1059.001/T1041"
