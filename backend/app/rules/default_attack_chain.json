    "mitre_attack": "T1053.005/T1041/T1003",
    "condition": {
      "_meta": {
        "mitre_attack": "T1053.005/T1041/T1003"
      },
      "window_minutes": 30,
      "host_scope": "single",
      "ordered_steps": [
        {
