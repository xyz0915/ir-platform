[
  {
    "name": "attack_chain_default_c2_persistence",
    "label": "默认攻击链：钓鱼投递→内存加载→C2外连→注册表持久化",
    "description": "关联检测 初始访问(可疑下载) → 执行(powershell -enc 内存加载) → 外连(C2 域名) → 持久化(注册表 Run 键) 的攻击链行为，覆盖 MITRE ATT&CK TA0001/TA0002/TA0011。",
    "category": "attack_chain",
    "rule_type": "attack_chain",
    "severity": "critical",
    "enabled": true,
    "source": "default",
    "mitre_attack": "TA0001/TA0002/TA0011",
    "condition": {
      "_meta": {
        "mitre_attack": "TA0001/TA0002/TA0011"
      },
      "window_minutes": 60,
      "host_scope": "single",
      "ordered_steps": [
        {
          "step": 1,
          "dimension": "process",
          "match": {
            "type": "regex",
            "field": "command_line",
            "pattern": "powershell.*-enc"
          }
        },
        {
          "step": 2,
          "dimension": "connection",
          "match": {
            "type": "list",
            "field": "remote_address",
            "values": [],
            "ioc_types": ["domain", "ip"],
            "match_mode": "contains",
            "_meta": {
              "requires_ioc": true,
              "ioc_note": "P0-1：原有 3 条硬编码占位域名/IP 为虚构指标，会导致本步永不命中、整条 critical 攻击链失效。已移除并改为依赖 iocs 表动态指标。"
            }
          }
        },
        {
          "step": 3,
          "dimension": "registry",
          "match": {
            "type": "regex",
            "field": "key_path",
            "pattern": "(?i).*\\\\Run"
          }
        }
      ]
    }
  },
  {
    "name": "lotl_chain_combo",
    "label": "LOTL 链式组合：压缩→解码→执行",
    "description": "Living-off-the-land 组合技：certutil 压缩/下载 → powershell 解码/执行 → 落盘 exe 运行。复用 attack_chain 主机级顺序关联框架（含 process 维 step）。",
    "category": "attack_chain",
    "rule_type": "attack_chain",
    "severity": "critical",
    "enabled": true,
    "source": "default",
    "mitre_attack": "T1105/T1059",
    "condition": {
      "_meta": {
        "mitre_attack": "T1105/T1059"
      },
      "window_minutes": 120,
      "host_scope": "single",
      "ordered_steps": [
        {
          "step": 1,
          "dimension": "process",
          "match": {
            "type": "regex",
            "field": "command_line",
            "pattern": "(?i)(certutil.*(-encode|-decode|-urlcache|-verify|-decodehex)|expand.*-r)"
          }
        },
        {
          "step": 2,
          "dimension": "process",
          "match": {
            "type": "regex",
            "field": "command_line",
            "pattern": "(?i)(powershell.*(-enc|-encodedcommand|-decode|-command)|cmd.*/c.*(echo|certutil))"
          }
        },
        {
          "step": 3,
          "dimension": "process",
          "match": {
            "type": "regex",
            "field": "command_line",
            "pattern": "(?i)(\\\\(temp|users\\\\|appdata).*\\.exe|rundll32|regsvr32|mshta)"
          }
        }
      ]
    }
  },
  {
    "name": "attack_chain_webshell_certutil",
    "label": "WebShell→certutil 下载→注册表持久化→C2 外连",
    "description": "WebShell 创建进程 → certutil 下载载荷 → 注册表 Run 键持久化 → C2 外连",
    "category": "attack_chain",
    "rule_type": "attack_chain",
    "severity": "critical",
    "enabled": true,
    "source": "default",
    "mitre_attack": "T1505.003/T1105/T1547.001/T1041",
    "condition": {
      "_meta": {
        "mitre_attack": "T1505.003/T1105/T1547.001/T1041"
      },
      "window_minutes": 60,
      "host_scope": "single",
      "ordered_steps": [
        {
          "step": 1,
          "dimension": "process",
          "match": {
            "type": "regex",
            "field": "command_line",
            "pattern": "(?i)(w3wp|tomcat|nginx|httpd).*cmd\\.exe"
          }
        },
        {
          "step": 2,
          "dimension": "process",
          "match": {
            "type": "regex",
            "field": "command_line",
            "pattern": "(?i)certutil.*(-urlcache|-verify|-split)"
          }
        },
        {
          "step": 3,
          "dimension": "registry",
          "match": {
            "type": "regex",
            "field": "key_path",
            "pattern": "(?i).*\\\\Run"
          }
        },
        {
          "step": 4,
          "dimension": "connection",
          "match": {
            "type": "threshold",
            "field": "remote_port",
            "operator": ">=",
            "value": 1024
          }
        }
      ]
    }
  },
  {
    "name": "attack_chain_rdp_psexec_lsass",
    "label": "RDP 爆破→PsExec→LSASS 转储→SMB 横向移动",
    "description": "RDP 爆破 → PsExec 远程执行 → LSASS 进程转储凭据 → SMB 横向移动",
    "category": "attack_chain",
    "rule_type": "attack_chain",
    "severity": "critical",
    "enabled": true,
    "source": "default",
    "mitre_attack": "T1110/T1570/T1003.001/T1021.002",
    "condition": {
      "_meta": {
        "requires_hitl": true,
        "mitre_attack": "T1110/T1570/T1003.001/T1021.002"
      },
      "window_minutes": 60,
      "host_scope": "single",
      "ordered_steps": [
        {
          "step": 1,
          "dimension": "process",
          "match": {
            "type": "regex",
            "field": "command_line",
            "pattern": "(?i)(eventvwr|termdd|3389)"
          }
        },
        {
          "step": 2,
          "dimension": "process",
          "match": {
            "type": "regex",
            "field": "command_line",
            "pattern": "(?i)psexec.*-s"
          }
        },
        {
          "step": 3,
          "dimension": "process",
          "match": {
            "type": "regex",
            "field": "command_line",
            "pattern": "(?i)(procdump.*lsass|comsvcs.*MiniDump|tasklist.*lsass)"
          }
        },
        {
          "step": 4,
          "dimension": "connection",
          "match": {
            "type": "list",
            "field": "remote_port",
            "values": [445, 139],
            "match_mode": "exact"
          }
        }
      ]
    }
  },
  {
    "name": "attack_chain_phishing_macro_ps_c2",
