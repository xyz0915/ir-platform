  {
    "name": "attack_chain_fileless_wmi_cred",
    "label": "无文件攻击→WMI 持久化→凭据收集",
    "description": "无文件 PowerShell 或 mshta 内存加载 → WMI 事件订阅持久化 → Mimikatz 凭据窃取",
    "category": "attack_chain",
    "rule_type": "attack_chain",
    "severity": "critical",
    "enabled": true,
    "source": "default",
    "mitre_attack": "T1059.001/T1059.005/T1546.003/T1003",
    "condition": {
      "_meta": {
        "mitre_attack": "T1059.001/T1059.005/T1546.003/T1003"
      },
      "window_minutes": 30,
      "host_scope": "single",
      "ordered_steps": [
        {
          "step": 1,
          "dimension": "process",
          "match": {
            "type": "regex",
            "field": "command_line",
            "pattern": "(?i)(powershell.*(IEX|Invoke-)|mshta.*(HTTP|http))"
          }
        },
        {
          "step": 2,
          "dimension": "process",
          "match": {
            "type": "regex",
            "field": "command_line",
            "pattern": "(?i)(wmic.*/namespace:\\\\root\\\\subscription|Register-WmiEvent)"
          }
        },
        {
          "step": 3,
          "dimension": "process",
          "match": {
            "type": "regex",
            "field": "command_line",
            "pattern": "(?i)(mimikatz|Invoke-Mimikatz|Get-Credential)"
          }
        }
      ]
    }
  }
]
