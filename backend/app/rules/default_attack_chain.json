  },
  {
    "name": "attack_chain_zerologon_dcsync",
    "label": "Zerologon→域控提权→DCSync→黄金票据",
    "description": "Zerologon 漏洞利用 → ntdsutil 提取 NTDS → Mimikatz DCSync 获取哈希 → 黄金票据攻击",
    "category": "attack_chain",
    "rule_type": "attack_chain",
    "severity": "critical",
    "enabled": true,
    "source": "default",
    "mitre_attack": "T1210/T1003.006/T1558.001",
    "condition": {
      "_meta": {
        "requires_hitl": true,
        "mitre_attack": "T1210/T1003.006/T1558.001"
      },
      "window_minutes": 60,
      "host_scope": "single",
      "ordered_steps": [
        {
          "step": 1,
          "dimension": "process",
          "match": {
            "type": "regex",
            "field": "command_line",
            "pattern": "(?i)(zerologon|CVE-2020-1472)"
          }
        },
        {
          "step": 2,
          "dimension": "process",
          "match": {
            "type": "regex",
            "field": "command_line",
            "pattern": "(?i)ntdsutil.*(acm|NTDS)"
          }
        },
        {
          "step": 3,
          "dimension": "process",
          "match": {
            "type": "regex",
            "field": "command_line",
            "pattern": "(?i)(mimikatz.*dcsync|lsadump::dcsync)"
          }
        }
      ]
    }
  },
  {
    "name": "attack_chain_log4j_shell_escalate",
    "label": "Log4j/Exchange 利用→WebShell→提权→信息收集",
    "description": "Log4j/JNDI 注入或 Exchange 漏洞利用 → WebShell 执行命令 → 提权 → 内网信息收集",
    "category": "attack_chain",
    "rule_type": "attack_chain",
    "severity": "critical",
    "enabled": true,
    "source": "default",
    "mitre_attack": "T1190/T1505.003/T1068/T1082",
    "condition": {
      "_meta": {
        "mitre_attack": "T1190/T1505.003/T1068/T1082"
      },
      "window_minutes": 60,
      "host_scope": "single",
      "ordered_steps": [
        {
          "step": 1,
          "dimension": "process",
          "match": {
            "type": "regex",
            "field": "command_line",
            "pattern": "(?i)(jndi|ldap.*log4j|CVE-2021-44228)"
          }
        },
        {
          "step": 2,
          "dimension": "process",
          "match": {
            "type": "regex",
            "field": "command_line",
            "pattern": "(?i)(w3wp.*cmd|tomcat.*cmd|nginx.*bash)"
          }
        },
        {
          "step": 3,
          "dimension": "process",
          "match": {
            "type": "regex",
            "field": "command_line",
            "pattern": "(?i)(systeminfo|whoami /all|net user|net group.*domain)"
          }
        },
        {
          "step": 4,
          "dimension": "connection",
          "match": {
            "type": "list",
            "field": "remote_port",
            "values": [80, 443, 8080],
            "match_mode": "exact"
          }
        }
      ]
    }
  },
  {
